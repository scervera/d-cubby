# D-cubby — local development (bin/dev).
#
#   cp env.development.example .env.local
#
# bin/dev copies the root .env.local into apps/api/.env.local and apps/web/.env.local on
# every start, so edit the ROOT copy only. Safe defaults; no real secrets needed.
#
# Production settings are different: install.sh writes them to .env next to
# docker-compose.yml. See .env.example for the full list.

RAILS_ENV=development
NODE_ENV=development

# --- Ports ------------------------------------------------------------------------------
# The browser only talks to Next.js; in development Next.js proxies /api and
# /rails/active_storage to Rails (apps/web/next.config.ts), as Caddy does in production.
DEV_API_PORT=4081
DEV_WEB_PORT=4080
APP_URL=http://localhost:4080
API_INTERNAL_URL=http://127.0.0.1:4081

# --- Database (compose.dev.yml) ---------------------------------------------------------
DEV_PG_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/d_cubby_development

# --- Rails ------------------------------------------------------------------------------
JWT_SECRET_KEY=development-only-jwt-secret-change-me
LOG_LEVEL=debug
# One-time token for the first-run /setup page.
SETUP_TOKEN=dev-setup-token

# --- Email (optional; without SMTP_HOST mail is only logged) ----------------------------
SMTP_HOST=
SMTP_PORT=1025

# --- Storage ----------------------------------------------------------------------------
STORAGE_PROVIDER=local

# --- AI auto-tagging (optional; see the dam gem README) ---------------------------------
# DAM_AI_PROVIDER=anthropic          # openai | anthropic | openai_compatible
# DAM_AI_API_KEY=
# DAM_AI_MODEL=
# DAM_AI_BASE_URL=                   # e.g. http://localhost:11434/v1 for Ollama
