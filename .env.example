# D-cubby configuration reference. ./install.sh writes .env for you; edit .env by hand only
# if you know what you're changing, then run: docker compose up -d
# Values are single-quoted so $ and # are taken literally.

# --- Release ------------------------------------------------------------------------------
APP_VERSION='latest'                 # image tag: ghcr.io/scervera/d-cubby-{api,web}:<tag>

# --- Address -------------------------------------------------------------------------------
APP_URL='https://dam.example.org'    # the address people open (used in emails and file links)
CADDY_SITE_ADDRESS='dam.example.org' # a domain name = automatic HTTPS; ':80' = plain HTTP
RAILS_DISABLE_SSL='false'            # 'true' for plain-HTTP installs
HTTP_PORT='80'
HTTPS_PORT='443'

# --- Secrets (generated by install.sh; never share) ----------------------------------------
SECRET_KEY_BASE=''
JWT_SECRET_KEY=''
POSTGRES_PASSWORD=''
SETUP_TOKEN=''                       # one-time token for /setup; ignored once setup is done

# --- File storage --------------------------------------------------------------------------
STORAGE_PROVIDER='local'             # local | s3
STORAGE_HOST_PATH=''                 # local: host directory for files (empty = Docker volume)
S3_ENDPOINT=''                       # s3: empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION='us-east-1'
S3_BUCKET=''
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''
S3_FORCE_PATH_STYLE=''               # 'true' for most non-AWS services (default: true when S3_ENDPOINT is set)

# --- Uploads ---------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_GB='5'               # proxy limit
DAM_MAX_FILE_SIZE_GB='5'             # app limit (keep equal to MAX_UPLOAD_SIZE_GB)

# --- Watched folders ---------------------------------------------------------------------------
# Host folders to import from, as name=path pairs separated by commas. Each is mounted
# read-only at /watched/<name> (install.sh writes docker-compose.override.yml).
WATCHED_MOUNTS=''                    # e.g. 'photos=/mnt/nas/photos,usb=/media/usb1'

# --- Email (optional) ----------------------------------------------------------------------------
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_TLS='starttls'                  # starttls | tls (port 465) | none
SMTP_FROM=''                         # e.g. 'Acme Media <dam@example.org>'

# --- AI auto-tagging (optional) ---------------------------------------------------------------------
DAM_AI_PROVIDER=''                   # openai | anthropic | openai_compatible (empty = off)
DAM_AI_API_KEY=''
DAM_AI_MODEL=''                      # empty = provider default (gpt-4o / claude-opus-5-5)
DAM_AI_BASE_URL=''                   # openai_compatible: e.g. http://192.168.1.20:11434/v1 (Ollama)

# --- Face detection (optional, AWS Rekognition) ---------------------------------------------------------
DAM_FACE_DETECTION_ENABLED='false'
AWS_REGION='us-east-1'
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''

# --- Tuning ---------------------------------------------------------------------------------------------------
WEB_CONCURRENCY='2'                  # Puma worker processes (1 = single process)
RAILS_MAX_THREADS='5'
JOB_CONCURRENCY='1'                  # Solid Queue worker processes
